{
  "name": "pagelove-pixo-companion-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A customizable digital companion template for focus, check-ins, care reminders, and private PageLove-backed memory.",
  "license": "MIT",
  "scripts": {
    "predev": "node scripts/prepare-room.mjs",
    "dev": "python3 -m http.server 4173",
    "build": "node scripts/build-site.mjs",
    "package:pagelove": "npm run build && node scripts/package-pagelove.mjs",
    "test": "node --test test/*.test.mjs",
    "voice:server": "node --env-file=server/.env server/voice-server.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "deploy:dry": "npm run build && node scripts/deploy.mjs --dry-run",
    "use-example": "node scripts/use-example.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "three": "0.180.0"
  }
}
